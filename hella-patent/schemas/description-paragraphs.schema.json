{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doc_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "doc_id",
    "source",
    "paragraphs"
  ]
}
