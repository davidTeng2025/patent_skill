{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scene": {
      "enum": [
        "fto",
        "patentability",
        "oa",
        "invalidity"
      ]
    },
    "left": {
      "type": "object"
    },
    "features": {
      "type": "array"
    },
    "columns": {
      "type": "array"
    },
    "highlights": {
      "type": "array"
    },
    "cells": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "column_id": {
            "type": "string"
          },
          "strength": {
            "enum": [
              "强",
              "中",
              "弱",
              "无"
            ]
          },
          "covered": {
            "type": "array"
          },
          "missing": {
            "type": "array"
          },
          "analysis": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "对应": {
                "type": "string"
              },
              "差别": {
                "type": "string"
              },
              "依据": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "对应",
              "差别",
              "依据"
            ]
          },
          "cite": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "reviewer_judgement": {
            "enum": [
              "相同",
              "等同",
              "不同",
              null
            ]
          },
          "reviewer_note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "feature_id",
          "column_id",
          "strength",
          "analysis",
          "cite",
          "quote"
        ]
      }
    },
    "claim_summary": {
      "type": "array"
    },
    "rejections": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "required": [
    "scene",
    "left",
    "features",
    "columns",
    "cells",
    "claim_summary",
    "rejections"
  ]
}
